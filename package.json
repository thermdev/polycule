{
  "name": "polycule",
  "version": "1.0.0",
  "private": true,
  "description": "3D visualizer for polyamorous relationship graphs",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run build && npm run start --workspace server"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
