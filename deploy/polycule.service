[Unit]
Description=Polycule server (Express + SQLite)
Documentation=https://github.com/thermdev/polycule
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu

# The server resolves ./data and ../client/dist relative to its own file,
# so it must run from the server directory.
WorkingDirectory=/srv/polycule/server
ExecStart=/usr/bin/node index.js

Environment=NODE_ENV=production
Environment=PORT=8787

Restart=always
RestartSec=2

StandardOutput=journal
StandardError=journal
SyslogIdentifier=polycule

# Hardening. SQLite needs write access to its data dir (and the -wal/-shm
# sidecars), so that path is carved out of the read-only filesystem.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/srv/polycule/server/data

[Install]
WantedBy=multi-user.target
